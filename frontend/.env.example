# AI Pulse Frontend Environment Configuration Template
# Copy this file to .env to override defaults:
#   cp .env.example .env

# Backend API Base URL
# Default is http://localhost:8001 (used when port 8000 is occupied).
# Set to http://localhost:8000 if running the backend on standard port 8000.
VITE_API_URL=http://localhost:8001

# Frontend Vite Development Server Port
# Default is 5174 (used when port 5173 is occupied).
# Set to 5173 if running on standard Vite port.
VITE_PORT=5174

