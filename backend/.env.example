# AI Pulse Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment:
#   cp .env.example .env

# Secret key used for signing JWT tokens (minimum 32 characters required)
# Generate a fresh key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Database connection URL (defaults to SQLite if omitted)
DATABASE_URL=sqlite:///./aipulse.db

# AI Mode: "mock" (canned local responses) or "live" (OpenAI-compatible chat completion endpoint)
AI_MODE=mock

# Required only when AI_MODE=live
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
